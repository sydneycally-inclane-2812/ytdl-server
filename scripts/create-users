#!/usr/bin/env bash
set -euo pipefail

GROUP_NAME="ytdl"
USERS=("ytdl-uvicorn" "ytdl-celery")

if [[ "${EUID}" -ne 0 ]]; then
	echo "This script must be run as root." >&2
	exit 1
fi

if ! getent group "$GROUP_NAME" >/dev/null; then
	groupadd "$GROUP_NAME"
	echo "Created group: $GROUP_NAME"
else
	echo "Group already exists: $GROUP_NAME"
fi

for user in "${USERS[@]}"; do
	if ! id -u "$user" >/dev/null 2>&1; then
		useradd -m -s /usr/sbin/nologin "$user"
		echo "Created user: $user"
	else
		echo "User already exists: $user"
	fi

	usermod -aG "$GROUP_NAME" "$user"
	echo "Ensured $user is in group: $GROUP_NAME"
done

echo "Done. Users ytdl-uvicorn and ytdl-celery are configured in group ytdl."