#!/usr/bin/env bash
set -euo pipefail
# This script starts the production services (uvicorn, celery worker, celery beat) with automatic restarts on failure.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TARGET_DIR="$PROJECT_ROOT/src"
cd "$TARGET_DIR"

SERVER_USER="${SERVER_USER:-ytdl-uvicorn}"
CELERY_USER="${CELERY_USER:-ytdl-celery}"
GROUP_NAME="${GROUP_NAME:-ytdl}"
CREATE_USERS_SCRIPT="$PROJECT_ROOT/scripts/create-users"
SYSTEMD_UNIT_PATH="${SYSTEMD_UNIT_PATH:-/etc/systemd/system/ytdl-server.service}"
CELERY_RUNTIME_DIR="${CELERY_RUNTIME_DIR:-$PROJECT_ROOT/logs/celery}"
CELERY_BEAT_SCHEDULE="${CELERY_BEAT_SCHEDULE:-$CELERY_RUNTIME_DIR/celerybeat-schedule}"
LOG_FILE_PATH="${LOG_FILE_PATH:-$PROJECT_ROOT/logs/ytdl-server.log}"
CONFIG_PATH="$PROJECT_ROOT/config/app_config.json"

umask 0002

write_systemd_unit_file() {
	if [[ "${EUID}" -ne 0 ]]; then
		echo "prod_startup must run as root to write $SYSTEMD_UNIT_PATH" >&2
		exit 1
	fi

	local temp_unit
	temp_unit="$(mktemp)"

	cat >"$temp_unit" <<EOF
[Unit]
Description=YT-DLP Server (FastAPI + Celery Worker + Celery Beat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=$PROJECT_ROOT
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/root/.local/bin:$PROJECT_ROOT/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=RESTART_DELAY_SECONDS=2
EnvironmentFile=-$PROJECT_ROOT/.env
ExecStart=$PROJECT_ROOT/scripts/prod_startup
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF

	if [[ ! -f "$SYSTEMD_UNIT_PATH" ]] || ! cmp -s "$temp_unit" "$SYSTEMD_UNIT_PATH"; then
		install -D -m 644 "$temp_unit" "$SYSTEMD_UNIT_PATH"
		systemctl daemon-reload
	fi

	rm -f "$temp_unit"
}

write_systemd_unit_file

if ! command -v jq >/dev/null 2>&1; then
	echo "jq not found in PATH." >&2
	exit 1
fi

ensure_system_accounts() {
	if [[ "${EUID}" -eq 0 ]]; then
		bash "$CREATE_USERS_SCRIPT"
	fi

	if ! getent group "$GROUP_NAME" >/dev/null; then
		echo "Missing group: $GROUP_NAME. Run as root so startup can create required users/groups." >&2
		exit 1
	fi

	for user in "$SERVER_USER" "$CELERY_USER"; do
		if ! id -u "$user" >/dev/null 2>&1; then
			echo "Missing user: $user. Run as root so startup can create required users/groups." >&2
			exit 1
		fi
	done

	if [[ "${EUID}" -ne 0 ]]; then
		echo "prod_startup must run as root to launch SERVER_USER=$SERVER_USER and CELERY_USER=$CELERY_USER" >&2
		exit 1
	fi
}

ensure_system_accounts

grant_traverse_access() {
	local user="$1"
	local path="$2"

	if command -v setfacl >/dev/null 2>&1; then
		setfacl -m "u:${user}:x" "$path"
		return
	fi

	chmod o+x "$path"
}

grant_file_access() {
	local user="$1"
	local path="$2"

	if command -v setfacl >/dev/null 2>&1; then
		setfacl -m "u:${user}:rx" "$path"
		return
	fi

	chmod o+rx "$path"
}

grant_traverse_chain() {
	local user="$1"
	local dir_path="$2"
	local current="$dir_path"

	while true; do
		grant_traverse_access "$user" "$current"
		if [[ "$current" == "/" ]]; then
			break
		fi
		current="$(dirname "$current")"
	done
}

resolve_config_path() {
	local configured_path="$1"
	if [[ -z "$configured_path" ]]; then
		echo ""
		return
	fi
	if [[ "$configured_path" == /* ]]; then
		echo "$configured_path"
	else
		echo "$PROJECT_ROOT/$configured_path"
	fi
}

ensure_group_writable_dir() {
	local path="$1"
	if [[ -z "$path" ]]; then
		return
	fi

	install -d -m 2775 "$path"
	chgrp "$GROUP_NAME" "$path"
	chmod g+rws "$path"
	if command -v setfacl >/dev/null 2>&1; then
		setfacl -m "g:${GROUP_NAME}:rwx" "$path"
		setfacl -d -m "g:${GROUP_NAME}:rwx" "$path"
	fi
}

prepare_runtime_permissions() {
	local current_env
	current_env="$(jq -r '.current // empty' "$CONFIG_PATH")"
	if [[ -z "$current_env" ]]; then
		echo "Missing .current in $CONFIG_PATH" >&2
		exit 1
	fi

	local configured_root_dir configured_temp_dir configured_database_path
	configured_root_dir="$(jq -r --arg env "$current_env" '.[$env].root_dir // empty' "$CONFIG_PATH")"
	configured_temp_dir="$(jq -r --arg env "$current_env" '.[$env].temp_dir // empty' "$CONFIG_PATH")"
	configured_database_path="$(jq -r --arg env "$current_env" '.[$env].database_path // empty' "$CONFIG_PATH")"

	local data_root_dir temp_root_dir db_path db_dir
	data_root_dir="$(resolve_config_path "$configured_root_dir")"
	temp_root_dir="$(resolve_config_path "$configured_temp_dir")"
	db_path="$(resolve_config_path "$configured_database_path")"
	db_dir="$(dirname "$db_path")"

	local user
	for user in "$SERVER_USER" "$CELERY_USER"; do
		local home_dir
		home_dir="$(getent passwd "$user" | cut -d: -f6)"
		install -d -o "$user" -g "$GROUP_NAME" -m 700 "$home_dir/.cache"
		install -d -o "$user" -g "$GROUP_NAME" -m 700 "$home_dir/.cache/uv"
	done

	ensure_group_writable_dir "$PROJECT_ROOT/logs"
	ensure_group_writable_dir "$CELERY_RUNTIME_DIR"
	ensure_group_writable_dir "$db_dir"
	ensure_group_writable_dir "$data_root_dir"
	ensure_group_writable_dir "$temp_root_dir"

	install -m 664 /dev/null "$LOG_FILE_PATH"
	chgrp "$GROUP_NAME" "$LOG_FILE_PATH"
	chmod g+rw "$LOG_FILE_PATH"

	chgrp -R "$GROUP_NAME" "$PROJECT_ROOT"
	find "$PROJECT_ROOT" -type d -exec chmod g+rx {} +
	find "$PROJECT_ROOT" -type f -exec chmod g+r {} +

	if [[ -n "$data_root_dir" && -d "$data_root_dir" ]]; then
		chgrp -R "$GROUP_NAME" "$data_root_dir"
		find "$data_root_dir" -type d -exec chmod g+rws {} +
		find "$data_root_dir" -type f -exec chmod g+rw {} +
	fi

	if [[ -n "$temp_root_dir" && -d "$temp_root_dir" ]]; then
		chgrp -R "$GROUP_NAME" "$temp_root_dir"
		find "$temp_root_dir" -type d -exec chmod g+rws {} +
		find "$temp_root_dir" -type f -exec chmod g+rw {} +
	fi

	if [[ -n "$db_dir" && -d "$db_dir" ]]; then
		chgrp -R "$GROUP_NAME" "$db_dir"
		find "$db_dir" -type d -exec chmod g+rws {} +
		find "$db_dir" -type f -exec chmod g+rw {} +
	fi

	if [[ -d "$PROJECT_ROOT/.venv" ]]; then
		chgrp -R "$GROUP_NAME" "$PROJECT_ROOT/.venv"
		chmod -R g+rX "$PROJECT_ROOT/.venv"
	fi

	if [[ "$PROJECT_ROOT" == /root/* && ! -x /root ]]; then
		grant_traverse_access "$SERVER_USER" /root
		grant_traverse_access "$CELERY_USER" /root
	fi

	local venv_python
	venv_python="$PROJECT_ROOT/.venv/bin/python3"
	if [[ -e "$venv_python" ]]; then
		local resolved_python
		resolved_python="$(readlink -f "$venv_python" || true)"

		for user in "$SERVER_USER" "$CELERY_USER"; do
			grant_traverse_chain "$user" "$(dirname "$venv_python")"
			grant_file_access "$user" "$venv_python"
			if [[ -n "$resolved_python" ]]; then
				grant_traverse_chain "$user" "$(dirname "$resolved_python")"
				grant_file_access "$user" "$resolved_python"
			fi
		done
	fi
}

prepare_runtime_permissions

# Parse the json to find the configured port for the current environment, defaulting to 8080 if not set 
CURRENT_ENV="$(jq -r '.current' "$CONFIG_PATH")"
PORT="$(jq -r --arg env "$CURRENT_ENV" '.[$env].port // 8080' "$CONFIG_PATH")"

# Export UV to PATH
if command -v uv >/dev/null 2>&1; then
	UV_BIN="uv"
else
	echo "uv not found in PATH." >&2
	exit 1
fi

RESTART_DELAY_SECONDS="${RESTART_DELAY_SECONDS:-2}"

PIDS=()

log() {
	printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

run_as_user() {
	local user="$1"
	shift

	if [[ "${EUID}" -eq 0 ]]; then
		runuser -u "$user" -- "$@"
		return
	fi

	"$@"
}

run_with_restart() {
	local name="$1"
	shift

	while true; do
		log "Starting ${name}"
		local exit_code=0
		if ! "$@"; then
			exit_code=$?
		fi
		log "${name} exited with code ${exit_code}; restarting in ${RESTART_DELAY_SECONDS}s"
		sleep "$RESTART_DELAY_SECONDS"
	done
}

shutdown() {
	log "Stopping managed processes"
	for pid in "${PIDS[@]}"; do
		kill "$pid" 2>/dev/null || true
	done
	wait
}

trap shutdown INT TERM EXIT

run_with_restart "uvicorn" \
	run_as_user "$SERVER_USER" "$UV_BIN" run --project "$PROJECT_ROOT" uvicorn main:app --host 0.0.0.0 --port "$PORT" --workers 1 --log-level info &
PIDS+=("$!")

run_with_restart "celery-worker" \
	run_as_user "$CELERY_USER" "$UV_BIN" run --project "$PROJECT_ROOT" celery -A celery_app worker --loglevel=INFO --pool=solo &
PIDS+=("$!")

run_with_restart "celery-beat" \
	run_as_user "$CELERY_USER" "$UV_BIN" run --project "$PROJECT_ROOT" celery -A celery_app beat --loglevel=INFO --schedule "$CELERY_BEAT_SCHEDULE" &
PIDS+=("$!")

log "Production services started (uvicorn user=${SERVER_USER}, celery user=${CELERY_USER})"
wait
