[Unit]
Description=YT-DLP Server (FastAPI + Celery Worker + Celery Beat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=ytdl
UMask=0002
WorkingDirectory={{WORKDIR}}
Environment=PYTHONUNBUFFERED=1
Environment=SERVER_USER=ytdl-uvicorn
Environment=CELERY_USER=ytdl-celery
Environment=GROUP_NAME=ytdl
Environment=PATH=/root/.local/bin:{{WORKDIR}}/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=RESTART_DELAY_SECONDS=2
EnvironmentFile=-{{WORKDIR}}/.env
ExecStart={{WORKDIR}}/scripts/server.sh
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
