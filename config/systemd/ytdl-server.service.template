[Unit]
Description=YT-DLP Server (FastAPI + Celery Worker + Celery Beat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=ytdl
UMask=0002
WorkingDirectory={{PROJECT_ROOT}}
Environment=PYTHONUNBUFFERED=1
Environment=SERVER_USER=ytdl-uvicorn
Environment=CELERY_USER=ytdl-celery
Environment=GROUP_NAME=ytdl
Environment=PATH=/root/.local/bin:{{PROJECT_ROOT}}/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=RESTART_DELAY_SECONDS=2
EnvironmentFile=-{{PROJECT_ROOT}}/.env
ExecStart={{PROJECT_ROOT}}/scripts/server-runner.sh
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
